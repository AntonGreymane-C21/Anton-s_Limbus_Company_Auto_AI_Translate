<!--
    边狱巴士暗色主题（只用于简易模式）。

    说明：
      - 本字典只由 Views/SimpleModeView.xaml 合并，作用域限定在简易模式内部；
        专家模式（原工作台）继续使用 App.xaml 的浅色样式，外观不变。
      - 隐式样式（Button / TextBox / CheckBox / ProgressBar / ScrollBar / Expander）都重写了模板，
        彻底覆盖 App.xaml 的浅色隐式样式。
      - 刻意不提供 TextBlock 隐式样式（会影响控件模板内部文字），文字颜色由各元素显式指定。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 调色板 ============ -->
    <Color x:Key="LimbusBgColor">#121214</Color>
    <Color x:Key="LimbusCardColor">#1C1C20</Color>
    <Color x:Key="LimbusGoldColor">#D4A24C</Color>
    <Color x:Key="LimbusRedColor">#8B1E2B</Color>

    <SolidColorBrush x:Key="LimbusBg" Color="#121214"/>
    <SolidColorBrush x:Key="LimbusHeader" Color="#0E0E10"/>
    <SolidColorBrush x:Key="LimbusCard" Color="#1C1C20"/>
    <SolidColorBrush x:Key="LimbusCardRaised" Color="#232328"/>
    <SolidColorBrush x:Key="LimbusInput" Color="#151518"/>
    <SolidColorBrush x:Key="LimbusCardBorder" Color="#2A2A30"/>
    <SolidColorBrush x:Key="LimbusDivider" Color="#26262B"/>
    <SolidColorBrush x:Key="LimbusText" Color="#E8E4DC"/>
    <SolidColorBrush x:Key="LimbusMuted" Color="#9A948A"/>
    <SolidColorBrush x:Key="LimbusFaint" Color="#5E5A54"/>
    <SolidColorBrush x:Key="LimbusGold" Color="#D4A24C"/>
    <SolidColorBrush x:Key="LimbusGoldDim" Color="#7A5F2E"/>
    <SolidColorBrush x:Key="LimbusGoldSoft" Color="#2A2216"/>
    <SolidColorBrush x:Key="LimbusRed" Color="#8B1E2B"/>
    <SolidColorBrush x:Key="LimbusRedHover" Color="#A3242F"/>
    <SolidColorBrush x:Key="LimbusRedPressed" Color="#6E1722"/>
    <SolidColorBrush x:Key="LimbusOk" Color="#6FAF7B"/>
    <SolidColorBrush x:Key="LimbusOkSoft" Color="#17241A"/>
    <SolidColorBrush x:Key="LimbusWarn" Color="#D4A24C"/>
    <SolidColorBrush x:Key="LimbusWarnSoft" Color="#2A2216"/>
    <SolidColorBrush x:Key="LimbusBlock" Color="#E0606C"/>
    <SolidColorBrush x:Key="LimbusBlockSoft" Color="#2A1518"/>

    <!-- 卡片顶部的金色细线（左亮右暗，模拟游戏 UI 的描边） -->
    <LinearGradientBrush x:Key="LimbusGoldRule" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D4A24C" Offset="0"/>
        <GradientStop Color="#7A5F2E" Offset="0.45"/>
        <GradientStop Color="#00D4A24C" Offset="1"/>
    </LinearGradientBrush>

    <!-- 背景：极淡的暗红晕染（不影响可读性） -->
    <RadialGradientBrush x:Key="LimbusBackdrop" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.7">
        <GradientStop Color="#1E1416" Offset="0"/>
        <GradientStop Color="#121214" Offset="1"/>
    </RadialGradientBrush>

    <FontFamily x:Key="LimbusFont">Microsoft YaHei UI</FontFamily>

    <!-- ============ 焦点框 ============ -->
    <Style x:Key="LimbusFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" StrokeThickness="1" Stroke="#D4A24C" StrokeDashArray="2 2" RadiusX="3" RadiusY="3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 按钮 ============ -->
    <!-- 默认按钮（次要）：深灰底 + 细边框 -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource LimbusFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LimbusText}"/>
        <Setter Property="Background" Value="#26262B"/>
        <Setter Property="BorderBrush" Value="#3A3A42"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LimbusFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#303036"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#7A5F2E"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1E1E22"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮：暗红底 + 金色描边，左侧一道金色斜切 -->
    <Style x:Key="LimbusPrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#F6EFE2"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="30,11"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MinWidth" Value="168"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Chrome" Background="{StaticResource LimbusRed}"
                                BorderBrush="{StaticResource LimbusGoldDim}" BorderThickness="1" CornerRadius="2"/>
                        <Path x:Name="Notch" Data="M0,0 L7,0 L0,7 Z" Fill="{StaticResource LimbusGold}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1"/>
                        <Path Data="M7,0 L7,7 L0,7 Z" Fill="{StaticResource LimbusGold}" Opacity="0.55"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="1"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource LimbusRedHover}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LimbusGold}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource LimbusRedPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="#3A2226"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#3A3A42"/>
                            <Setter TargetName="Notch" Property="Fill" Value="#5E5A54"/>
                            <Setter Property="Foreground" Value="#8A8278"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幽灵按钮：透明底 + 细边框 -->
    <Style x:Key="LimbusGhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#3A3A42"/>
        <Setter Property="Foreground" Value="{StaticResource LimbusMuted}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- 文字链接按钮 -->
    <Style x:Key="LimbusLinkButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource LimbusFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource LimbusGold}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LimbusFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 顶栏右侧的图标按钮（⚙ 设置） -->
    <Style x:Key="LimbusHeaderButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource LimbusMuted}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="28"/>
    </Style>

    <!-- 简易 | 专家 分段切换（RadioButton） -->
    <Style x:Key="LimbusSegment" TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="{StaticResource LimbusFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource LimbusMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LimbusFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Chrome" Background="Transparent" Padding="14,4" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource LimbusText}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource LimbusGold}"/>
                            <Setter Property="Foreground" Value="#1A1408"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 输入框 ============ -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource LimbusFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource LimbusText}"/>
        <Setter Property="Background" Value="{StaticResource LimbusInput}"/>
        <Setter Property="BorderBrush" Value="#34343B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource LimbusGold}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource LimbusGold}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#4A4A52"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LimbusGold}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 只读文本区（原文 / 日志）：不显示边框高亮 -->
    <Style x:Key="LimbusReadOnlyText" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="IsUndoEnabled" Value="False"/>
    </Style>

    <!-- ============ 复选框 ============ -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource LimbusFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource LimbusText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource LimbusFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="2" VerticalAlignment="Top" Margin="0,1,0,0"
                                Background="{StaticResource LimbusInput}" BorderBrush="#4A4A52" BorderThickness="1">
                            <Path x:Name="Mark" Data="M3,9 L7,13 L15,4" Stroke="#1A1408" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LimbusGold}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource LimbusGold}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LimbusGold}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 进度条（金色，带不定进度动画） ============ -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Foreground" Value="{StaticResource LimbusGold}"/>
        <Setter Property="Background" Value="#2A2A30"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="TemplateRoot" ClipToBounds="True" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#8B6A2F" Offset="0"/>
                                    <GradientStop Color="#E3B661" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Shimmer" Width="120" HorizontalAlignment="Left" CornerRadius="3" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00D4A24C" Offset="0"/>
                                    <GradientStop Color="#D4A24C" Offset="0.5"/>
                                    <GradientStop Color="#00D4A24C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ShimmerShift" X="-120"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Shimmer" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ShimmerRun">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ShimmerShift" Storyboard.TargetProperty="X"
                                                         From="-120" To="900" Duration="0:0:1.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="ShimmerRun"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 滚动条（细、暗） ============ -->
    <Style x:Key="LimbusScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbChrome" Background="#3A3A42" CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="#7A5F2E"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="#D4A24C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LimbusScrollPage" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource LimbusScrollPage}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource LimbusScrollThumb}" MinHeight="24"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource LimbusScrollPage}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource LimbusScrollPage}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource LimbusScrollThumb}" MinWidth="24"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource LimbusScrollPage}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ 折叠面板（运行日志） ============ -->
    <Style x:Key="LimbusExpanderToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" Padding="0,6">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Arrow" Data="M0,0 L4,4 L0,8 Z" Fill="{StaticResource LimbusMuted}"
                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ArrowTurn" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource LimbusGold}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource LimbusGold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{StaticResource LimbusMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource LimbusFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top" Style="{StaticResource LimbusExpanderToggle}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"/>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,6,0,0"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 卡片与文字 ============ -->
    <Style x:Key="LimbusCardPanel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource LimbusCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LimbusCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 卡片左上角的小标签：「STEP 03 · 翻译」 -->
    <Style x:Key="LimbusEyebrow" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource LimbusGold}"/>
        <Setter Property="FontFamily" Value="{StaticResource LimbusFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="LimbusHeading" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource LimbusText}"/>
        <Setter Property="FontFamily" Value="{StaticResource LimbusFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="LimbusBody" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource LimbusMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource LimbusFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="LimbusLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource LimbusFaint}"/>
        <Setter Property="FontFamily" Value="{StaticResource LimbusFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- 大数字（「1,284」） -->
    <Style x:Key="LimbusBigNumber" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource LimbusGold}"/>
        <Setter Property="FontFamily" Value="Bahnschrift, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="44"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- 状态提示条（Tag = ok / warn / block） -->
    <Style x:Key="LimbusNotice" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Background" Value="{StaticResource LimbusWarnSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LimbusWarn}"/>
        <Setter Property="TextElement.Foreground" Value="#E9D3A6"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="ok">
                <Setter Property="Background" Value="{StaticResource LimbusOkSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LimbusOk}"/>
                <Setter Property="TextElement.Foreground" Value="#BFE0C5"/>
            </Trigger>
            <Trigger Property="Tag" Value="block">
                <Setter Property="Background" Value="{StaticResource LimbusBlockSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LimbusBlock}"/>
                <Setter Property="TextElement.Foreground" Value="#F2C4C8"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
