<Window x:Class="LimbusTranslator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="边狱巴士 · 自动增量汉化"
        Height="1000" Width="1320" MinHeight="720" MinWidth="1080"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Closing="MainWindow_Closing"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
    <Grid Margin="18" MinWidth="1044">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="560"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部身份与状态 -->
        <Border Grid.Row="0" Background="#151D30" CornerRadius="16" Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12" Background="#A6425D" VerticalAlignment="Center">
                    <TextBlock Text="LC" Foreground="White" FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="边狱巴士 · 自动增量汉化工作台" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="先分析差异，再按分类翻译；输出仅部署本轮已核验通过的文件。"
                               Foreground="#AEBBD0" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#24324A" CornerRadius="10" Padding="13,8" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="当前状态" Foreground="#AEBBD0" FontSize="10"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="#F7FAFF" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 数据源与主任务区 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="数据源与任务" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="路径可以手动指定；执行中的任务会锁定任务按钮，避免不同操作互相覆盖。"
                               Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,11,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F8FAFD" BorderBrush="#E4EAF2" BorderThickness="1" CornerRadius="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="旧英文目录" Foreground="#50617A" FontWeight="SemiBold" FontSize="12"/>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OldEnglishDir, UpdateSourceTrigger=PropertyChanged}" ToolTip="用于识别英文版本改动"/>
                                <Button Grid.Column="1" Content="浏览" Margin="7,0,0,0" Style="{StaticResource TaskButton}" Click="BrowseOldEn_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#F8FAFD" BorderBrush="#E4EAF2" BorderThickness="1" CornerRadius="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="旧中文目录" Foreground="#50617A" FontWeight="SemiBold" FontSize="12"/>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OldChineseDir, UpdateSourceTrigger=PropertyChanged}" ToolTip="用于继承旧汉化和判定缺失译文"/>
                                <Button Grid.Column="1" Content="浏览" Margin="7,0,0,0" Style="{StaticResource TaskButton}" Click="BrowseOldZh_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Background="#F8FAFD" BorderBrush="#E4EAF2" BorderThickness="1" CornerRadius="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="新版英文目录" Foreground="#50617A" FontWeight="SemiBold" FontSize="12"/>
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewEnglishDir, UpdateSourceTrigger=PropertyChanged}" ToolTip="作为本轮翻译和 output 合并的英文模板"/>
                                <Button Grid.Column="1" Content="浏览" Margin="7,0,0,0" Style="{StaticResource TaskButton}" Click="BrowseNewEn_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <WrapPanel Grid.Row="2">
                    <Button Content="自动定位游戏" Style="{StaticResource TaskButton}" Background="#ECF8F4" Foreground="#147A62" BorderBrush="#B9E2D7"
                            Margin="0,0,8,0" Click="LocateGameDir_Click" ToolTip="自动读取游戏的英文和中文目录"/>
                    <Button Content="开始 Diff 分析" Style="{StaticResource TaskButton}" Background="#2E6BDE" Foreground="White" BorderBrush="#2E6BDE"
                            IsEnabled="{Binding CanAnalyzeAction, Mode=OneWay}"
                            Margin="0,0,8,0" Click="RunDiff_Click" ToolTip="分析文件与条目差异，并刷新翻译范围"/>
                    <Button Content="提取待汉化文件" Style="{StaticResource TaskButton}" Background="#FFF5E6" Foreground="#9A5A0D" BorderBrush="#F3D29B"
                            Margin="0,0,8,0" Click="ExtractNewFiles_Click" ToolTip="复制新增、修改和缺失汉化的文件到 data/work/pending"/>
                    <Button Content="开始汉化" Style="{StaticResource TaskButton}" Background="#A6425D" Foreground="White" BorderBrush="#A6425D"
                            IsEnabled="{Binding CanTranslateAction, Mode=OneWay}"
                            Margin="0,0,8,0" Click="RunTranslate_Click" ToolTip="翻译已勾选分类，并生成经过校验的 output"/>
                    <Button Content="从缓存恢复 output" Style="{StaticResource TaskButton}" Background="#F2EEFC" Foreground="#6741B4" BorderBrush="#D9CEF6"
                            Margin="0,0,8,0" Click="RecoverOutput_Click" ToolTip="不调用 API；使用当前英文哈希命中的翻译缓存恢复 output"/>
                    <!-- 第9.0C.8轮：把 data/output 里已写好的译文读回来（载入界面 + 导入 TM），
                         这样重启程序后也能接着审核 / 重新输出 / 部署，不需要重新翻译 -->
                    <Button Content="从 output 载入进度" Style="{StaticResource TaskButton}" Background="#EAF6F0" Foreground="#147A62" BorderBrush="#C9E7DA" Margin="0,0,8,0" Click="LoadProgressFromOutput_Click" ToolTip="读取 data/output 的译文：载入到逐条列表（来源=Imported）并写入翻译记忆；不调用 API"/>
                    <Button Content="配置" Style="{StaticResource TaskButton}" Margin="0,0,8,0" Click="OpenSettings_Click" ToolTip="编辑 API、提示词、术语库和角色风格"/>
                    <!-- 第9.0C.1轮：取消当前操作（分析 / 翻译 / 生成 / 部署中可用） -->
                    <Button Content="{Binding CancelButtonText, Mode=OneWay}" Style="{StaticResource TaskButton}"
                            Background="#FDF2F4" Foreground="#A6425D" BorderBrush="#F0D3DA" Margin="0,0,8,0"
                            IsEnabled="{Binding CanCancelOperation, Mode=OneWay}"
                            Click="CancelOperation_Click"
                            ToolTip="请求取消当前操作：分析/翻译会停在安全点；不会写入半成品输出，也不会部署"/>
                    <Button Content="部署到游戏" Style="{StaticResource TaskButton}" Background="#147A62" Foreground="White" BorderBrush="#147A62"
                            IsEnabled="{Binding IsDeployAllowed, Mode=OneWay}"
                            Click="DeployToGame_Click" ToolTip="只部署最近一次输出清单中已核验通过的文件，并自动备份旧文件"/>
                    <!-- 第9.0C.9轮：部署到自选汉化文件夹（同一套门禁/备份/回滚流程，只是目标目录由你选） -->
                    <Button Content="部署到汉化文件夹…" Style="{StaticResource TaskButton}" Background="#EAF6F0" Foreground="#147A62" BorderBrush="#C9E7DA" IsEnabled="{Binding IsDeployAllowed, Mode=OneWay}" Click="DeployToFolder_Click" ToolTip="选择一个汉化文件夹作为目标（例如另一个游戏副本或发布用目录）；同样先备份、失败会回滚"/>
                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}">
                        <Run Text="发布状态 "/>
                        <Run Text="{Binding GateStatusText, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding GateStatusBrush, Mode=OneWay}"/>
                        <Run Text="  Error "/><Run Text="{Binding GateErrorCount, Mode=OneWay}" FontWeight="Bold" Foreground="#B02A37"/>
                        <Run Text="  Warning "/><Run Text="{Binding GateWarningCount, Mode=OneWay}" FontWeight="Bold" Foreground="#C17717"/>
                        <Run Text="  待审核 "/><Run Text="{Binding GateNeedsReviewCount, Mode=OneWay}" FontWeight="Bold" Foreground="#6741B4"/>
                        <Run Text="  历史继承结构问题 "/><Run Text="{Binding GateHistoricalInheritedErrorCount, Mode=OneWay}" FontWeight="Bold" Foreground="#9A5A0D"/>
                    </TextBlock>
                    <!-- 第9.0C轮：发布检查状态（人话，技术值仍在「查看门禁原因」里） -->
                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}">
                        <Run Text="发布检查 "/>
                        <Run Text="{Binding GateStatusDisplayText, Mode=OneWay}" FontWeight="Bold" Foreground="#24324A"/>
                    </TextBlock>

                    <CheckBox VerticalAlignment="Center" Margin="14,0,0,0"
                              Visibility="{Binding GateConfirmationVisibility, Mode=OneWay}"
                              IsChecked="{Binding GateConfirmationAcknowledged, Mode=TwoWay}"
                              Content="我已知晓这些警告，继续部署"
                              ToolTip="确认只对当前输出清单有效；重新生成输出后需要重新确认"/>
                    <Button Content="查看门禁原因" Style="{StaticResource TaskButton}" Background="#FFF5E6" Foreground="#9A5A0D" BorderBrush="#F3D29B"
                            Margin="10,0,0,0" Click="ShowGateReasons_Click" ToolTip="显示门禁结论、阻断原因与可定位的问题样本"/>
                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}">
                        <Run Text="已提取 "/><Run Text="{Binding ExtractedCount, Mode=OneWay}" Foreground="#C17717" FontWeight="SemiBold"/><Run Text=" 个文件"/>
                    </TextBlock>
                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Visibility="{Binding CancellingHintVisibility}"
                               Foreground="#A6425D" FontSize="12" Text="{Binding CancellingHintText, Mode=OneWay}"/>
                </WrapPanel>

            <!-- 第9.0C轮：翻译模式选择 + 首次使用引导（普通用户无需手改配置文件） -->
            <StackPanel Grid.Row="3" Margin="0,13,0,0">
                <Border Visibility="{Binding FirstRunGuideVisibility}" Background="#EEF4FB" BorderBrush="#DBE7F5"
                        BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="开始使用（第一次打开会显示这段引导）" FontWeight="SemiBold" Foreground="#2D3748"/>
                        <TextBlock Text="{Binding FirstRunGuideText}" Foreground="#4A5568" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#F7F4FF" BorderBrush="#E1D8FA" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Width="230" Margin="0,0,14,0">
                            <TextBlock Text="翻译模式" FontWeight="SemiBold" Foreground="#2D3748"/>
                            <TextBlock Text="决定使用哪种官方原文作为翻译依据" Style="{StaticResource MutedText}" Margin="0,2,0,6"/>
                            <ComboBox ItemsSource="{Binding ModeOptions}"
                                      SelectedItem="{Binding SelectedModeOption, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChangeMode}"
                                      DisplayMemberPath="Headline"
                                      ToolTip="选择后会自动保存到配置，下次启动保持"/>
                            <TextBlock Text="{Binding ModeLockHintText}" Foreground="#7A6AA8" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ModeSubtitleText}" FontWeight="SemiBold" Foreground="#4A3A7A"/>
                            <TextBlock Text="{Binding ModeDescriptionText}" Foreground="#4A5568" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding NoTranslateHintText}" Visibility="{Binding NoTranslateHintVisibility}"
                                       Foreground="#147A62" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            </Grid>
        </Border>

        <!-- 统计摘要 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="#EEF4FB" BorderBrush="#DBE7F5" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,8">
                <WrapPanel>
                    <TextBlock Text="文件级摘要" FontWeight="SemiBold" Foreground="#38506F" Margin="0,0,10,0"/>
                    <TextBlock Text="新增 " Foreground="#7A5260"/><TextBlock Text="{Binding FileNewCount}" FontWeight="Bold" Foreground="#A6425D" Margin="0,0,12,0"/>
                    <TextBlock Text="缺失汉化 " Foreground="#7A5260"/><TextBlock Text="{Binding FileMissingCount}" FontWeight="Bold" Foreground="#6741B4" Margin="0,0,12,0"/>
                    <TextBlock Text="修改 " Foreground="#7A5260"/><TextBlock Text="{Binding FileModifiedCount}" FontWeight="Bold" Foreground="#C17717" Margin="0,0,12,0"/>
                    <TextBlock Text="已就绪 " Foreground="#7A5260"/><TextBlock Text="{Binding FileUnchangedCount}" FontWeight="Bold" Foreground="#147A62" Margin="0,0,12,0"/>
                    <TextBlock Text="删除 " Foreground="#7A5260"/><TextBlock Text="{Binding FileDeletedCount}" FontWeight="Bold" Foreground="#718096"/>
                </WrapPanel>
            </Border>
            <UniformGrid Grid.Row="1" Columns="5">
                <Border Background="#FFF3F5" BorderBrush="#F5D8DE" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="新增条目" Foreground="#8A5A67" FontSize="11"/><TextBlock Text="{Binding AddedCount}" Foreground="#A6425D" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Background="#FFF8ED" BorderBrush="#F4E1BA" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="修改条目" Foreground="#8A6A35" FontSize="11"/><TextBlock Text="{Binding ModifiedCount}" Foreground="#C17717" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Background="#EDF8F5" BorderBrush="#CBEBDD" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="可继承条目" Foreground="#4D7D70" FontSize="11"/><TextBlock Text="{Binding UnchangedCount}" Foreground="#147A62" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Background="#F3F5F8" BorderBrush="#E1E6ED" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="删除条目" Foreground="#718096" FontSize="11"/><TextBlock Text="{Binding DeletedCount}" Foreground="#53637B" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                </Border>
                <Border Background="#F5F1FD" BorderBrush="#E0D7F5" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel><TextBlock Text="缺失旧译" Foreground="#77619B" FontSize="11"/><TextBlock Text="{Binding MissingCount}" Foreground="#6741B4" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                </Border>
            </UniformGrid>
            <!-- 第9.0C轮：本次更新统计（人话）+ 门禁下一步提示 -->
            <Border Grid.Row="2" Background="#F7FAFF" BorderBrush="#E1EAF7" BorderThickness="1" CornerRadius="10"
                    Padding="10,7" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="本次更新统计" FontWeight="SemiBold" Foreground="#38506F"/>
                    <TextBlock Text="{Binding AnalysisDashboardText}" Foreground="#4A5568" FontSize="12"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding GateNextStepText}" Foreground="#7A6AA8" FontSize="12"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 第8.8轮：项目状态 / 运行统计 / Token 统计 / Thinking 统计（只读展示） -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="项目状态" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding GameDirStatusText, StringFormat=游戏目录：{0}}" Foreground="#4A5568" FontSize="12"/>
                    <TextBlock Text="{Binding ProviderStatusText, StringFormat=翻译 Provider：{0}}" Foreground="#4A5568" FontSize="12"/>
                    <TextBlock Text="{Binding ModelStatusText, StringFormat=模型：{0}}" Foreground="#4A5568" FontSize="12"/>
                    <TextBlock Text="{Binding DatabaseStatusText, StringFormat=翻译数据库：{0}}" Foreground="#4A5568" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ConfigStatusText, StringFormat=配置：{0}}" Foreground="#4A5568" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ThinkingModeStatusText, StringFormat=思考模式：{0}}" Foreground="#4A5568" FontSize="12"/>
                    <TextBlock Text="{Binding AiNeededCount, StringFormat=真正需要 AI：{0}}" Foreground="#2E6BDE" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding PassthroughCandidateCount, StringFormat=直通（空/纯符号）：{0}}" Foreground="#718096" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="本轮运行统计" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding RunStatsText}" Foreground="#4A5568" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="Thinking 统计" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,8,0,6"/>
                    <TextBlock Text="{Binding ThinkingStatsText}" Foreground="#4A5568" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Token / 耗时统计" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding TokenStatsText}" Foreground="#4A5568" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="Thinking 统计（条目决策）" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,8,0,4"/>
                    <TextBlock Text="{Binding ThinkingStatsText}" Foreground="#4A5568" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="Thinking 统计（实际 Provider 请求）" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,8,0,4"/>
                    <TextBlock Text="{Binding ActualThinkingStatsText}" Foreground="#4A5568" FontSize="12" TextWrapping="Wrap"/>
                    <CheckBox Content="显示调试日志" IsChecked="{Binding ShowDebugLogs}" Margin="0,8,0,0" FontSize="12"/>
                    <Expander Header="发布 / 部署信息" Margin="0,8,0,0" FontSize="12">
                        <StackPanel>
                            <TextBlock Text="{Binding DeployInfoText}" Foreground="#4A5568" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LastDeployStatusText}" Foreground="#9A5A0D" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LastDeployOutcomeText}" Foreground="#4A5568" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <!-- 第9.0C轮：门禁问题列表（双击定位到审核条目） -->
                            <TextBlock Text="本次检查发现的问题（双击可定位到审核条目）" Foreground="#718096" FontSize="11" Margin="0,6,0,2"/>
                            <DataGrid ItemsSource="{Binding GateIssueRows, Mode=OneWay}" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False" Height="110" FontSize="11"
                                      MouseDoubleClick="GateIssues_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="类型" Width="150" Binding="{Binding Headline, Mode=OneWay}"/>
                                    <DataGridTextColumn Header="文件" Width="140" Binding="{Binding FilePath, Mode=OneWay}"/>
                                    <DataGridTextColumn Header="UnitKey" Width="*" Binding="{Binding UnitKey, Mode=OneWay}"/>
                                    <DataGridTextColumn Header="说明" Width="160" Binding="{Binding Explanation, Mode=OneWay}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                    <Expander Header="高级详情（指纹 / 清单 Id）" Margin="0,6,0,0" FontSize="12">
                        <TextBlock Text="{Binding AdvancedDetailText}" Foreground="#718096" FontSize="11" TextWrapping="Wrap"/>
                    </Expander>
                    <TextBlock Text="待确认术语（只读）" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,10,0,4"/>
                    <ItemsControl ItemsSource="{Binding PendingTerms}" FontSize="11" Foreground="#9A5A0D"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工作区 -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="14" Padding="4" Margin="0,0,0,12">
            <TabControl>
                <TabItem Header="任务范围">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#F5F9FF" BorderBrush="#D9E7F8" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="选择本轮要处理的分类" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="勾选决定翻译、术语扫描、缓存恢复和 output 的范围。" Style="{StaticResource MutedText}" Margin="10,2,0,0"/>
                                    <Button Content="全选" Padding="9,2" Margin="16,0,0,0" Click="SelectAllCategories_Click"/>
                                    <Button Content="清空" Padding="9,2" Margin="6,0,0,0" Click="DeselectAllCategories_Click"/>
                                </StackPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding CategoryStats}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#D6E3F3" BorderThickness="1" CornerRadius="8" Padding="9,5" Margin="0,0,8,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#31415C" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                                    <TextBlock Text="需译 " Foreground="#718096" FontSize="11" Margin="10,1,0,0"/>
                                                    <TextBlock Text="{Binding NeedTranslateFileCount}" Foreground="#A6425D" FontWeight="Bold" FontSize="11"/>
                                                    <TextBlock Text=" / 总 " Foreground="#718096" FontSize="11"/>
                                                    <TextBlock Text="{Binding TotalFileCount}" Foreground="#53637B" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                <TextBlock Text="需要处理的文件" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="勾选决定本轮真正送进 AI 的文件；未勾选的文件本轮保持不变。" Style="{StaticResource MutedText}" Margin="10,2,0,0"/>
                                <Button Content="全选" Padding="9,2" Margin="16,0,0,0" Click="SelectAllFiles_Click"/>
                                <Button Content="全不选" Padding="9,2" Margin="6,0,0,0" Click="SelectNoneFiles_Click"/>
                                <Button Content="反选" Padding="9,2" Margin="6,0,0,0" Click="InvertFiles_Click"/>
                                <CheckBox Content="显示无需 AI 的文件" IsChecked="{Binding ShowFilesWithoutAi, Mode=TwoWay}" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding FileSelectionSummaryText}" Foreground="#31415C" FontWeight="SemiBold" Margin="3,0,0,7" TextWrapping="Wrap"/>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding FileTasks}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                                      EnableRowVirtualization="True" SelectionMode="Single" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="本轮处理" Width="80" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- 第9.0C.3.1修复：复选框只用「单向绑定 + 点击处理器」写入。
                                                     原因：模板列可编辑时第一次点击会被 DataGrid 拿去做"进入编辑模式"（行变蓝但勾不上），
                                                     且行虚拟化回收容器时双向绑定会把旧值回写到新行（把默认全选洗成 0 个）。 -->
                                                <CheckBox HorizontalAlignment="Center" Focusable="False"
                                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                          Click="FileTaskCheckBox_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="文件" Width="*" Binding="{Binding LogicalFile, Mode=OneWay}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="类型" Width="120" Binding="{Binding CategoryName, Mode=OneWay}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="待翻译" Width="70" Binding="{Binding NeedTranslateCount, Mode=OneWay}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="统计" Width="300" Binding="{Binding SummaryText, Mode=OneWay}" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="增量术语库">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#F8F6FD" BorderBrush="#E4DDF5" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="增量术语工作流" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="严格模式会忽略普通英文、界面短语和角色描述词；只保留需要上下文判断的专名、固定术语，并先与 glossary.json 比对。"
                                               Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="本地快速扫描术语" Style="{StaticResource TaskButton}" Background="#2E6BDE" Foreground="White" BorderBrush="#2E6BDE" Margin="0,0,7,0" Click="ScanTerms_Click"/>
                                    <!-- 第9.0C.10轮：AI 找生词（真实调用 DeepSeek）与独立的中止按钮 -->
                                    <Button Content="AI 找生词（调 API）" Style="{StaticResource TaskButton}" Background="#147A62" Foreground="White" BorderBrush="#147A62" Margin="0,0,7,0" Click="AiScanTerms_Click" ToolTip="把选中文件的文本交给 DeepSeek，由 AI 挑出它不认识/不确定的词（含建议译名）；会消耗 Token"/>
                                    <Button Content="中止所有 AI 对话" Style="{StaticResource TaskButton}" Background="#FDF2F4" Foreground="#A6425D" BorderBrush="#F0D3DA" Margin="0,0,7,0" Click="AbortAllAi_Click" IsEnabled="{Binding IsBusy, Mode=OneWay}" ToolTip="立刻中止所有正在进行的 AI 对话（翻译 / 找生词 / 生成解释 / 分析），不会再发送新的请求"/>
                                    <Button Content="生成解释" Style="{StaticResource TaskButton}" Background="#6741B4" Foreground="White" BorderBrush="#6741B4" Margin="0,0,7,0" Click="ExplainTerms_Click" ToolTip="DeepSeek 的单一推荐译名会自动填入待写入译名列"/>
                                    <Button Content="写入术语库" Style="{StaticResource TaskButton}" Background="#147A62" Foreground="White" BorderBrush="#147A62" Click="WriteTerms_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{Binding IncrementalTermStatus}" Foreground="#6741B4" FontWeight="SemiBold" Margin="3,0,0,8"/>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding IncrementalTerms}" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False">
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExisting}" Value="True">
                                            <Setter Property="Background" Value="#F5F7FA"/>
                                            <Setter Property="Foreground" Value="#7B8798"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="写入" Width="54">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanWrite}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="状态" Width="72" Binding="{Binding StatusText, Mode=OneWay}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="英文术语" Width="*" Binding="{Binding OriginalText, Mode=OneWay}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="术语库已有译名" Width="150" Binding="{Binding ExistingTranslation, Mode=OneWay}" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="推荐 / 待写入译名" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Translation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanWrite}"
                                                     BorderThickness="0" Background="Transparent" Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="出现" Width="58" Binding="{Binding OccurrenceCount, Mode=OneWay}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="来源" Width="58" Binding="{Binding SourceFileCount, Mode=OneWay}" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="DeepSeek 解释 / 由来" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Explanation}" ToolTip="{Binding Explanation}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="待审核">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 第8.86轮：筛选 + 结果统计 + 人工审核操作 -->
                        <Border Grid.Row="0" Background="#F3F7FF" BorderBrush="#D6E2FB" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="筛选：" VerticalAlignment="Center" Foreground="#4A5568" FontSize="12"/>
                                <ComboBox Width="230" FontSize="12" ItemsSource="{Binding ReviewFilterOptions}"
                                          SelectedItem="{Binding SelectedReviewFilter, Mode=TwoWay}" Margin="6,0,12,0"/>
                                <TextBlock Text="{Binding ReviewFilterSummaryText}" VerticalAlignment="Center"
                                           Foreground="#2D3748" FontSize="12"/>
                                <!-- 第9.0C轮：搜索（中文 / 英文 / 韩文 / 日文 / UnitKey / 文件名 / Speaker） -->
                                <TextBox Width="180" Margin="10,0,0,0" FontSize="12"
                                         Text="{Binding ReviewSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                         ToolTip="搜索译文、原文、UnitKey、文件名或说话人"/>
                                <Button Content="保存当前审核" Padding="10,3" Margin="14,0,0,0" Click="SaveReview_Click"                                        ToolTip="写回 HumanReviewed（NeedsReview=false），并重新运行 Validator 校验"/>
                                <Button Content="确认当前筛选中无 Error 条目" Padding="10,3" Margin="8,0,0,0" Click="BulkConfirmReview_Click"
                                        ToolTip="只把无 Error 的条目标记为人工审核通过；不会修改任何译文"/>
                                <!-- 第9.0C.12轮：分页（每页 5000 条）+ 跳页 + 跳文件 + 跳到待审（放在筛选旁边） -->
                                <TextBlock Text="{Binding ReviewPagerText}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#2D3748" FontSize="12"/>
                                <Button Content="◀ 上一页" Padding="8,2" Margin="10,0,0,0" Click="ReviewPrevPage_Click" IsEnabled="{Binding CanGoPreviousReviewPage}"/>
                                <Button Content="下一页 ▶" Padding="8,2" Margin="6,0,0,0" Click="ReviewNextPage_Click" IsEnabled="{Binding CanGoNextReviewPage}"/>
                                <TextBox Width="54" Margin="10,0,0,0" FontSize="12" Text="{Binding ReviewJumpPageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="跳到第 N 页"/>
                                <Button Content="跳页" Padding="8,2" Margin="4,0,0,0" Click="ReviewJumpPage_Click"/>
                                <TextBox Width="90" Margin="10,0,0,0" FontSize="12" Text="{Binding ReviewJumpFileText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="跳到包含该文件名的页（例如 S1000B）"/>
                                <Button Content="跳文件" Padding="8,2" Margin="4,0,0,0" Click="ReviewJumpFile_Click"/>
                                <Button Content="跳到待审" Padding="8,2" Margin="10,0,0,0" Click="ReviewJumpNeedsReview_Click" ToolTip="跳到第一个需要人工审核的条目所在页"/>
                                <TextBlock Text="{Binding ReviewSaveStatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="#9A5A0D" FontSize="12"/>
                            <!-- 第8.88轮：逐条审校工作台导航栏（与筛选同一行容器内） -->
                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                <Button Content="开始逐条审校" Padding="10,3" Click="BeginSequentialReview_Click"
                                        ToolTip="按当前筛选顺序逐条审校（Ctrl+Enter 通过并下一条；Alt+←/→ 上一条/下一条）"/>
                                <Button Content="◀ 上一条" Padding="10,3" Margin="12,0,0,0" Click="SequentialPrev_Click"
                                        IsEnabled="{Binding CanGoPrevious}"/>
                                <Button Content="通过并下一条 ▶" Padding="10,3" Margin="6,0,0,0" Click="SequentialApprove_Click"
                                        ToolTip="保存译文 → HumanReviewed → 重新 Validator；若仍有结构安全 Error 则不跳转"/>
                                <Button Content="下一条" Padding="10,3" Margin="6,0,0,0" Click="SequentialNext_Click"
                                        IsEnabled="{Binding CanGoNext}"/>
                                <TextBlock Text="{Binding SequentialPositionText}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding HasUnsavedSequentialEdit, StringFormat=未保存修改: {0}}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" Foreground="#B06000"/>
                                <Button Content="标记待处理" Padding="10,3" Margin="12,0,0,0" Click="SequentialMarkPending_Click"/>
                                <Button Content="保存" Padding="10,3" Margin="6,0,0,0" Click="SaveReview_Click"/>
                            </StackPanel>
                            </StackPanel>

                            <!-- 第9.0C.7轮：批量替换（把逐条审校时发现的错译一次性改掉；可同时写入术语库） -->
                            <Expander Header="批量替换（逐条审校时发现的错译 → 一次性修正；可同时写入术语库）" Margin="0,8,0,0" FontSize="12">
                                <Border Background="#FFF8ED" BorderBrush="#F3E1BE" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="查找：" VerticalAlignment="Center" Foreground="#4A5568"/>
                                            <TextBox Width="150" FontSize="12" Margin="4,0,10,0"
                                                     Text="{Binding ReviewReplaceFind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="当前译文里出现的错误译法，例如 护士长"/>
                                            <TextBlock Text="替换为：" VerticalAlignment="Center" Foreground="#4A5568"/>
                                            <TextBox Width="150" FontSize="12" Margin="4,0,14,0"
                                                     Text="{Binding ReviewReplaceWith, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="正确译法，例如 护父"/>
                                            <TextBlock Text="范围：" VerticalAlignment="Center" Foreground="#4A5568"/>
                                            <ComboBox Width="150" FontSize="12" Margin="4,0,10,0"
                                                      ItemsSource="{Binding ReviewReplaceScopeOptions}"
                                                      SelectedIndex="{Binding ReviewReplaceScopeIndex, Mode=TwoWay}"/>
                                            <CheckBox Content="区分大小写" FontSize="12" VerticalAlignment="Center"
                                                      IsChecked="{Binding ReviewReplaceCaseSensitive, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <CheckBox Content="同时写入术语库" FontSize="12" VerticalAlignment="Center"
                                                      IsChecked="{Binding ReviewReplaceWriteGlossary, Mode=TwoWay}"/>
                                            <TextBlock Text="源文（英文/韩文原词）：" VerticalAlignment="Center" Foreground="#4A5568" Margin="12,0,0,0"/>
                                            <TextBox Width="160" FontSize="12" Margin="4,0,10,0"
                                                     Text="{Binding ReviewReplaceGlossarySource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="术语库的键必须是原词，例如 Nursefather"/>
                                            <CheckBox Content="锁定（Locked）" FontSize="12" VerticalAlignment="Center"
                                                      IsChecked="{Binding ReviewReplaceGlossaryLocked, Mode=TwoWay}"/>
                                            <Button Content="预览命中" Padding="10,3" Margin="14,0,0,0" Click="PreviewReviewReplace_Click"
                                                    IsEnabled="{Binding CanPreviewReviewReplace}"/>
                                            <Button Content="执行替换" Padding="10,3" Margin="8,0,0,0" Click="ApplyReviewReplace_Click"
                                                    IsEnabled="{Binding CanPreviewReviewReplace}"/>
                                            <Button Content="撤销上次替换" Padding="10,3" Margin="8,0,0,0" Click="UndoReviewReplace_Click"
                                                    IsEnabled="{Binding CanUndoReviewReplace}"/>
                                            <TextBlock Text="{Binding ReviewReplaceGlossaryHint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                       Foreground="#9A5A0D" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ReviewReplacePreviewText}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="#31415C" MaxHeight="120"/>
                                        <TextBlock Text="{Binding ReviewReplaceStatusText}" TextWrapping="Wrap" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#147A62" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="#FFF8ED" BorderBrush="#F3E1BE" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="需要人工确认" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding ReviewCount}" Foreground="#C17717" FontSize="18" FontWeight="Bold" Margin="9,-2,0,0"/>
                                    <TextBlock Text=" 条" Style="{StaticResource MutedText}" Margin="2,2,0,0"/>
                                    <TextBlock Text="修改译文后可重新输出；缓存恢复不会调用 API。" Style="{StaticResource MutedText}" Margin="12,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="审核后重新输出" Style="{StaticResource TaskButton}" Background="#2E6BDE" Foreground="White" BorderBrush="#2E6BDE" Margin="0,0,7,0" Click="RegenerateOutput_Click"
                            IsEnabled="{Binding CanGenerateOutputAction, Mode=OneWay}"/>
                                    <Button Content="从缓存恢复 output" Style="{StaticResource TaskButton}" Background="#F2EEFC" Foreground="#6741B4" BorderBrush="#D9CEF6" Click="RecoverOutput_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- 第8.86轮：左表格 / 右详情 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" MinWidth="360"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.3*" MinWidth="320"/>
                            </Grid.ColumnDefinitions>
                            <DataGrid Grid.Column="0" ItemsSource="{Binding ReviewEntriesView}"
                                      SelectedItem="{Binding SelectedReviewEntry, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="False" HeadersVisibility="Column" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="状态" Width="96" Binding="{Binding NeedsReview, StringFormat=待审核:{0}, Mode=OneWay}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="文件" Width="150" Binding="{Binding Key.RelativeFilePath, Mode=OneWay}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="RecordId" Width="80" Binding="{Binding Key.RecordId, Mode=OneWay}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Field" Width="150" Binding="{Binding Key.FieldPath, Mode=OneWay}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Speaker" Width="90" Binding="{Binding Speaker, Mode=OneWay}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="英文原文" Width="*" Binding="{Binding NewSourceText, Mode=OneWay}" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="译文（可编辑）" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBox Text="{Binding Translation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="4,2"/></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="来源" Width="90" Binding="{Binding Provenance, Mode=OneWay}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="校验问题" Width="200" Binding="{Binding ReviewReason, Mode=OneWay}" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#E1E8F0"/>
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ReviewDetailHeaderText}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ReviewMetaText}" Style="{StaticResource MutedText}" Margin="0,6,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ReviewProvenanceText}" Style="{StaticResource MutedText}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ReviewStatusText}" Foreground="#9A5A0D" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <!-- 第9.0C轮：四模式原文展示（权威 / 参考 / 其他语言参考） -->
                                    <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
                                        <Run Text="当前模式：" FontWeight="SemiBold" Foreground="#4A3A7A"/>
                                        <Run Text="{Binding ReviewModeDisplayName, Mode=OneWay}" Foreground="#4A3A7A"/>
                                        <Run Text="　状态："/><Run Text="{Binding ReviewStateDisplayText, Mode=OneWay}" Foreground="#9A5A0D"/>
                                        <Run Text="　实际翻译来源："/><Run Text="{Binding ReviewEffectiveLanguageText, Mode=OneWay}" Foreground="#24324A"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ReviewPrimaryLabel, Mode=OneWay, StringFormat={}{0}（只读）}"
                                               Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding ReviewPrimaryText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                                    <TextBlock Text="{Binding ReviewPrimaryNote, Mode=OneWay}" Foreground="#718096"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <StackPanel Visibility="{Binding ReviewReferenceVisibility}">
                                        <TextBlock Text="{Binding ReviewReferenceLabel, Mode=OneWay, StringFormat={}{0}（只读）}"
                                                   Style="{StaticResource MutedText}" Margin="0,8,0,2"/>
                                        <TextBox Text="{Binding ReviewReferenceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 AcceptsReturn="True" Height="48" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                                        <TextBlock Text="{Binding ReviewReferenceNote, Mode=OneWay}" Foreground="#718096"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Expander Header="其他语言参考（该模式不参与翻译）" Margin="0,8,0,0" FontSize="12"
                                              Visibility="{Binding ReviewReferenceVisibility}">
                                        <ItemsControl ItemsSource="{Binding ReviewOtherLanguages, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}"/>
                                                        <TextBox Text="{Binding DisplayText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                                 AcceptsReturn="True" MinHeight="34" MaxHeight="80" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                                                        <TextBlock Text="{Binding Note}" Foreground="#A0AEC0" FontSize="10" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                    <TextBlock Text="{Binding ReviewOldChineseText, Mode=OneWay, StringFormat=旧中文：{0}}"
                                               Style="{StaticResource MutedText}" Margin="0,8,0,2" TextWrapping="Wrap"/>

                                    <TextBlock Text="Source" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding ReviewSourceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="56" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                                    <TextBlock Text="Old Source" Style="{StaticResource MutedText}" Margin="0,8,0,2"/>
                                    <TextBox Text="{Binding ReviewOldSourceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="44" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                                    <TextBlock Text="Old Translation" Style="{StaticResource MutedText}" Margin="0,8,0,2"/>
                                    <TextBox Text="{Binding ReviewOldTranslationText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="44" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                                    <TextBlock Text="Current Translation（可编辑后点上方「保存当前审核」）" Foreground="#2E6BDE" FontSize="12" Margin="0,10,0,2"/>
                                    <TextBox Text="{Binding ReviewCurrentTranslation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="84" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                                    <TextBlock Text="校验问题（ValidationIssues）" Style="{StaticResource MutedText}" Margin="0,10,0,2"/>
                                    <DataGrid ItemsSource="{Binding ReviewIssues}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" Height="120" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Severity" Width="80" Binding="{Binding Severity, Mode=OneWay}"/>
                                            <DataGridTextColumn Header="Code" Width="180" Binding="{Binding Code, Mode=OneWay}"/>
                                            <DataGridTextColumn Header="Category" Width="90" Binding="{Binding Category, Mode=OneWay}"/>
                                            <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message, Mode=OneWay}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{Binding ReviewAiReviewReasonText, Mode=OneWay}"
                                               Visibility="{Binding ReviewAiReviewVisibility}"
                                               Foreground="#9A5A0D" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding ReviewIssuePanelNote, Mode=OneWay, StringFormat=校验问题：{0}}"
                                               Style="{StaticResource MutedText}" Margin="0,10,0,2"/>
                                    <DataGrid ItemsSource="{Binding ReviewLanguageIssues, Mode=OneWay}" AutoGenerateColumns="False"
                                              IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" Height="110" FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="级别" Width="70" Binding="{Binding SeverityText, Mode=OneWay}"/>
                                            <DataGridTextColumn Header="问题" Width="170" Binding="{Binding Name, Mode=OneWay}"/>
                                            <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Explanation, Mode=OneWay}"/>
                                            <DataGridTextColumn Header="技术码" Width="170" Binding="{Binding Code, Mode=OneWay}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{Binding ReviewTermPanelNote, Mode=OneWay, StringFormat=相关术语：{0}}"
                                               Style="{StaticResource MutedText}" Margin="0,10,0,2"/>
                                    <ItemsControl ItemsSource="{Binding ReviewTermRows, Mode=OneWay}" FontSize="11" Foreground="#4A5568">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Headline}" TextWrapping="Wrap"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ReviewNeighborLanguageLabel, Mode=OneWay}"
                                               Style="{StaticResource MutedText}" Margin="0,10,0,2"/>
                                    <TextBlock Text="{Binding ReviewNeighborNote, Mode=OneWay}" Foreground="#718096"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="上一句（只读）" Style="{StaticResource MutedText}" FontSize="11"/>
                                            <TextBox Text="{Binding ReviewNeighborPreviousText, Mode=OneWay}" IsReadOnly="True"
                                                     TextWrapping="Wrap" AcceptsReturn="True" Height="52" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="下一句（只读）" Style="{StaticResource MutedText}" FontSize="11"/>
                                            <TextBox Text="{Binding ReviewNeighborNextText, Mode=OneWay}" IsReadOnly="True"
                                                     TextWrapping="Wrap" AcceptsReturn="True" Height="52" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                    <Expander Header="技术详情（内部字段，普通用户不需要）" Margin="0,8,0,0" FontSize="11">
                                        <ItemsControl ItemsSource="{Binding ReviewTechnicalRowsTexts, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding}" Foreground="#718096" FontSize="11" TextWrapping="Wrap"/></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <TextBox Text="{Binding ReviewMatchedTermsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True" MinHeight="42" MaxHeight="120" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                                    <TextBlock Text="邻句上下文（只读，来自运行前快照）" Style="{StaticResource MutedText}" Margin="0,10,0,2"/>
                                    <TextBox Text="{Binding ReviewNeighborText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="76" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="条目级 Diff">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="条目差异预览（最多显示前 200 条）" Style="{StaticResource MutedText}" Margin="2,0,0,8"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="处理动作" Width="145" Binding="{Binding Action, Mode=OneWay}"/>
                                <DataGridTextColumn Header="变化" Width="90" Binding="{Binding DiffKind, Mode=OneWay}"/>
                                <DataGridTextColumn Header="文件" Width="190" Binding="{Binding Key.RelativeFilePath, Mode=OneWay}"/>
                                <DataGridTextColumn Header="英文原文" Width="*" Binding="{Binding NewSourceText, Mode=OneWay}"/>
                                <DataGridTextColumn Header="最终译文" Width="*" Binding="{Binding Translation, Mode=OneWay}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 当前任务进度 -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E1E8F0" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="当前任务" Foreground="#718096" FontSize="10"/>
                    <TextBlock Text="{Binding ProgressOperation}" Foreground="#24324A" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding ProgressValue, StringFormat={}{0:F0}%}" Foreground="#2E6BDE" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
                <!-- 第9.0C轮：底部状态栏（模式 / API / 分析 / 翻译 / 待审核 / 输出） -->
                <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding StatusBarText}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- 可复制日志 -->
        <Border Grid.Row="5" Background="#151D30" CornerRadius="12" Padding="10" MinHeight="155">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="120"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="2,0,2,7">
                    <StackPanel>
                        <TextBlock Text="运行日志" Foreground="#E3EBF7" FontWeight="SemiBold"/>
                        <TextBlock Text="支持拖选、Ctrl+C 和“复制全部”；滚到底部自动跟随，向上浏览时暂停。" Foreground="#93A4BD" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Content="复制全部" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,3" FontSize="11"
                            Background="#263650" Foreground="#DDEBFF" BorderBrush="#3A4C69" Click="CopyLogs_Click"/>
                </Grid>
                <TextBox Grid.Row="1" x:Name="LogTextBox" Text="{Binding DisplayLogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         Background="#101727" Foreground="#99D7FF" CaretBrush="#E0F2FE" BorderBrush="#263650" Padding="7" FontFamily="Consolas" FontSize="12"
                         IsUndoEnabled="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="LogTextBox_TextChanged" ScrollViewer.ScrollChanged="LogTextBox_ScrollChanged"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
